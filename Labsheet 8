#include <iostream>
using namespace std;
int main ( )
{
void prime(int n)
{
    int i;
    for (i = 2; i < n; i++)
    {
        if (n % i == 0)
        {
            cout << "Not a Prime Number";
            return;
        }
    }

    if (n > 1)
        cout << "Prime Number";
    else
        cout << "Not a Prime Number";
}

int main()
{
    int n;
    cout << "Enter a number: ";
    cin >> n;

    prime(n);

    return 0;
}
